# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini          # gemini | groq (embeddings always use Gemini)
GEMINI_API_KEY=
GROQ_API_KEY=
API_KEY=                     # optional; if set, clients must send X-API-Key

# Admin audit endpoints (disabled when empty) and rate limit (requests/min per client, 0 = off)
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Change before exposing anywhere beyond your machine
POSTGRES_PASSWORD=rag
# Host port for the web UI (nginx)
WEB_PORT=8080

# Second-layer ML prompt-injection detector (needs GROQ_API_KEY): off | groq
# Measured on held-out attacks: regex alone catches 10%, regex + ML catches 75%, 0 false positives.
ML_GUARD=off

# If the primary LLM provider is out of quota or down, retry on the other (needs its key)
LLM_FALLBACK=true

# Accounts: private uploads and per-user history. Leave off for a single-user local setup.
# For anything public set AUTH_ENABLED=true and a long random JWT_SECRET (e.g. `openssl rand -hex 32`).
AUTH_ENABLED=false
JWT_SECRET=
ALLOW_SIGNUP=true
# Who administers the system. Empty: the first account to register. On a public server set your own address.
ADMIN_EMAIL=
# Role of new accounts: editor (can upload) or viewer (read and ask only). The first account is always admin.
DEFAULT_ROLE=editor

# How many earlier exchanges are used to understand a follow-up question (0 = off). Costs one extra model call per follow-up.
MEMORY_TURNS=3

# Big uploads: documents filed in the background at once, and how often to wait out an embedding rate limit
INGEST_CONCURRENCY=2
EMBED_RATE_LIMIT_RETRIES=8

# Spending guards: tokens per rolling 24 hours (0 = no limit). Per person (admins exempt) and across everyone.
USER_DAILY_TOKEN_LIMIT=0
GLOBAL_DAILY_TOKEN_LIMIT=0

# Data retention (0 = keep forever). Conversations untouched for this many days, and audit rows older than this, are deleted.
RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
# When an account is deleted, also delete its audit rows (false) or keep them unlinked from the person (true)
KEEP_AUDIT_ON_ACCOUNT_DELETE=false

# Sign-in protection: lock an email after this many wrong passwords, for this many minutes (0 attempts = off)
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Password reset: link lifetime, the address used in the link, and where mail goes.
# With SMTP_HOST empty the reset link is only written to the backend log (local development).
RESET_TTL_MINUTES=30
PUBLIC_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Citewise <no-reply@localhost>

# Session cookie Secure flag: auto | true | false. Use true when serving over HTTPS.
COOKIE_SECURE=auto

# Answers citing a document not updated for this many days carry an outdated-source warning (0 = off)
STALE_AFTER_DAYS=365
