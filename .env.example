# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini          # gemini | groq (embeddings always use Gemini)
GEMINI_API_KEY=
GROQ_API_KEY=
API_KEY=                     # optional; if set, clients must send X-API-Key

# Admin audit endpoints (disabled when empty) and rate limit (requests/min per client, 0 = off)
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Change before exposing anywhere beyond your machine
POSTGRES_PASSWORD=rag
# Host port for the web UI (nginx)
WEB_PORT=8080

# Second-layer ML prompt-injection detector (needs GROQ_API_KEY): off | groq
# Measured on held-out attacks: regex alone catches 10%, regex + ML catches 75%, 0 false positives.
ML_GUARD=off

# If the primary LLM provider is out of quota or down, retry on the other (needs its key)
LLM_FALLBACK=true

# Accounts: private uploads and per-user history. Leave off for a single-user local setup.
# For anything public set AUTH_ENABLED=true and a long random JWT_SECRET (e.g. `openssl rand -hex 32`).
AUTH_ENABLED=false
JWT_SECRET=
ALLOW_SIGNUP=true
# Role of new accounts: editor (can upload) or viewer (read and ask only). The first account is always admin.
DEFAULT_ROLE=editor

# How many earlier exchanges are used to understand a follow-up question (0 = off). Costs one extra model call per follow-up.
MEMORY_TURNS=3

# Answers citing a document not updated for this many days carry an outdated-source warning (0 = off)
STALE_AFTER_DAYS=365
