# Production settings for Citewise. Copy to .env on the server (or paste into your host's variable settings),
# fill in every blank, then check it:   python scripts/preflight.py
# Never commit the filled-in copy. Secrets here stay blank on purpose.

# --- the model (embeddings always use Gemini) ---
LLM_PROVIDER=groq              # gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_FALLBACK=true              # if one provider is out of quota or down, use the other
ML_GUARD=groq                  # second layer against prompt injection; needs GROQ_API_KEY

# --- who gets in ---
AUTH_ENABLED=true
JWT_SECRET=                    # openssl rand -hex 32
ADMIN_EMAIL=                   # YOUR address: only this account becomes admin
ALLOW_SIGNUP=true              # set false once your people have accounts
POSTGRES_PASSWORD=             # a long random value, set BEFORE the first start (it is baked into the data volume)
ADMIN_API_KEY=                 # optional, for scripts: openssl rand -hex 24

# --- the connection ---
PUBLIC_URL=https://your.domain # used in password-reset links
COOKIE_SECURE=true             # the session cookie is only ever sent over HTTPS
TRUSTED_PROXY=true             # the bundled nginx sets the client address

# --- mail (without SMTP, reset links only appear in the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Citewise <no-reply@your.domain>

# --- limits: protect your model quota and your bill ---
RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
USER_DAILY_TOKEN_LIMIT=60000       # about 100 questions per person per day
GLOBAL_DAILY_TOKEN_LIMIT=400000    # keep this under your provider's daily quota

# --- data ---
RETENTION_DAYS=0               # delete conversations untouched for this many days (0 = keep)
AUDIT_RETENTION_DAYS=0
STALE_AFTER_DAYS=365

WEB_PORT=8080                  # the port nginx listens on; put HTTPS (Caddy, your host's proxy) in front of it
